{
  "schemaVersion": 1,
  "id": "tokenlogin",
  "version": "${version}",
  "name": "TokenLogin",
  "description": "Log in with a refresh token: converts it into an access token, manages multiple accounts with avatars, refreshes tokens automatically and shows when they expire. Mod Menu is supported (optional).",
  "authors": [
    "ItzAugustus"
  ],
  "license": "CC0-1.0",
  "icon": "assets/tokenlogin/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.kcl.tokenlogin.client.TokenLoginClient"
    ],
    "modmenu": [
      "com.kcl.tokenlogin.client.compat.TokenLoginModMenu"
    ]
  },
  "mixins": [
    {
      "config": "tokenlogin.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.17.3",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "recommends": {
    "modmenu": ">=17.0.1"
  }
}
